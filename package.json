{
  "name": "brepkit-bench",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible head-to-head benchmark: brepkit vs OCCT (WASM), with output verification before timing",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench": "tsx bench.ts",
    "bench:json": "tsx bench.ts --json",
    "verify": "tsx bench.ts --verify-only"
  },
  "dependencies": {
    "brepjs": "18.120.0",
    "brepkit-wasm": "3.0.0",
    "occt-wasm": "3.8.3",
    "tsx": "4.23.1"
  },
  "license": "MIT"
}
